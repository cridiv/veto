{
  "name": "veto",
  "version": "0.1.0",
  "private": true,
  "description": "Veto - Real-time AI Agent Firewall",
  "scripts": {
    "build": "pnpm -r run build",
    "clean": "pnpm -r run clean",
    "test": "pnpm --filter backend test && pnpm --filter backend test:e2e",
    "test:unit": "pnpm --filter backend test",
    "test:e2e": "pnpm --filter backend test:e2e",
    "test:live": "node scripts/e2e-live-test.mjs",
    "test:sdk": "node scripts/demo-sdk.mjs",
    "start:acme": "pnpm --filter @veto/acme start",
    "dev:web": "pnpm --filter @veto/web dev"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "unrs-resolver"
    ]
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
